@model RestaurantBookingSystem.ViewModels.Events.EventDetailsViewModel

@{
    ViewData["Title"] = "Delete Event";
}

<h2 class="text-center mb-4 text-danger">
    <span class="title-container">Delete Event</span>
</h2>

<div class="soft-box" style="max-width: 600px; margin: 0 auto;">
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i>
        <strong>Are you sure you want to delete this event?</strong>
    </div>

    <div class="card mb-4">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" style="max-height: 300px; object-fit: cover;">
        }
        <div class="card-body">
            <h4 class="card-title">@Model.Name</h4>
            <p class="card-text">@Model.Description</p>
            <p class="text-muted">
                <i class="bi bi-calendar"></i> @Model.Date.ToString("MMMM dd, yyyy")
            </p>
            <p>
                Status:
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </p>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="text-center">
            <button type="submit" class="btn btn-danger px-4">
                <i class="bi bi-trash"></i> Yes, Delete Event
            </button>
            <a class="btn btn-secondary px-4" href="/Admin/Events">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
        </div>
    </form>
</div>