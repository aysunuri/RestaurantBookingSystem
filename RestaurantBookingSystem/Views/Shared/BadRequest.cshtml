@{
    ViewData["Title"] = "Bad Request";
}

<h2 class="text-center mb-4">
    <span class="title-container text-danger">400 - Bad Request</span>
</h2>

<div class="soft-box text-center" style="max-width: 700px; margin: 0 auto;">
    <div class="mb-4">
        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 4rem;"></i>
    </div>

    <p class="lead mb-3">
        Sorry, the request could not be understood or was missing required parameters.
    </p>

    <p class="text-muted mb-4">
        The server cannot process your request due to invalid syntax or missing information.
    </p>

    <div class="mt-4">
        <a class="btn btn-primary px-4 me-2" href="javascript:history.back()">
            <i class="bi bi-arrow-left"></i> Go Back
        </a>
        <a class="btn btn-secondary px-4" asp-controller="Home" asp-action="Index">
            <i class="bi bi-house-door"></i> Go Home
        </a>
    </div>
</div>