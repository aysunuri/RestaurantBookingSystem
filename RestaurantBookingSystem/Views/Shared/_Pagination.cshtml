@model PagedResult<ReservationIndexViewModel>

@{
    bool showAll = ViewBag.ShowAll ?? false;
}

<div class="text-center mt-4">
	@if (Model.TotalPages > 1)
	{
		@if (Model.CurrentPage > 1)
		{
			<a class="btn btn-outline-primary"
			   asp-action="Index"
			   asp-route-page="@(Model.CurrentPage - 1)"
			   asp-route-showAll="@ViewBag.ShowAll">
				Previous
			</a>
		}
		else
		{
			<button class="btn btn-outline-secondary" disabled>Previous</button>
		}

		int startPage = Math.Max(1, Model.CurrentPage - 2);
		int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);


		@for (int i = startPage; i <= endPage; i++)
		{
			<a class="btn @(i == Model.CurrentPage ? "btn-primary" : "btn-outline-primary")"
			   asp-action="Index"
			   asp-route-page="@i"
			   asp-route-showAll="@ViewBag.ShowAll">
				@i
			</a>
		}

		@if (Model.CurrentPage < Model.TotalPages)
		{
			<a class="btn btn-outline-primary"
			   asp-action="Index"
			   asp-route-page="@(Model.CurrentPage + 1)"
			   asp-route-showAll="@ViewBag.ShowAll">
				Next
			</a>
		}
		else
		{
			<button class="btn btn-outline-secondary" disabled>Next</button>
		}
	}
	else
	{
		<button class="btn btn-outline-secondary" disabled>Previous</button>
		<button class="btn btn-primary">1</button>
		<button class="btn btn-outline-secondary" disabled>Next</button>
	}

	@if (Model.Items.Any())
	{
		<div class="text-muted mt-2">
			<small>Page @Model.CurrentPage of @Model.TotalPages</small>
		</div>
	}
</div>