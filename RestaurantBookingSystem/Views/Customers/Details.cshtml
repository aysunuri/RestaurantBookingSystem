@model RestaurantBookingSystem.ViewModels.Customer.CustomerDetailsViewModel

@{
    ViewData["Title"] = $"{Model.FullName} - Details";
}

<h2 class="text-center mb-4">
    <span class="title-container">Customer Details</span>
</h2>

<div class="soft-box" style="max-width: 900px; margin: 0 auto;">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <h4 class="mb-3">Customer Information</h4>
            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8"><strong>@Model.FullName</strong></dd>

                <dt class="col-sm-4">Phone</dt>
                <dd class="col-sm-8">@Model.PhoneNumber</dd>

                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@(Model.Email ?? "-")</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    @switch (Model.Status)
                    {
                        case RestaurantBookingSystem.Data.Models.Enums.CustomerStatus.VIP:
                            <span class="badge bg-warning text-dark">
                                <i class="bi bi-star-fill"></i> VIP
                            </span>
                            break;
                        case RestaurantBookingSystem.Data.Models.Enums.CustomerStatus.Blacklisted:
                            <span class="badge bg-danger">
                                <i class="bi bi-x-circle-fill"></i> Blacklisted
                            </span>
                            break;
                        default:
                            <span class="badge bg-secondary">Regular</span>
                            break;
                    }
                </dd>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <dt class="col-sm-4">Staff Notes</dt>
                    <dd class="col-sm-8">
                        <div class="alert alert-info mb-0">
                            <small>@Model.Notes</small>
                        </div>
                    </dd>
                }
            </dl>
        </div>

        <div class="col-md-6">
            <h4 class="mb-3">Reservation Statistics</h4>
            <dl class="row">
                <dt class="col-sm-6">Total Reservations</dt>
                <dd class="col-sm-6"><span class="badge bg-info">@Model.TotalReservations</span></dd>

                <dt class="col-sm-6">Upcoming</dt>
                <dd class="col-sm-6"><span class="badge bg-success">@Model.UpcomingReservations</span></dd>

                <dt class="col-sm-6">Completed</dt>
                <dd class="col-sm-6"><span class="badge bg-secondary">@Model.CompletedReservations</span></dd>

                <dt class="col-sm-6">First Reservation</dt>
                <dd class="col-sm-6">
                    @if (Model.FirstReservationDate.HasValue)
                    {
                        @Model.FirstReservationDate.Value.ToString("MMM dd, yyyy")
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </dd>

                <dt class="col-sm-6">Last Reservation</dt>
                <dd class="col-sm-6">
                    @if (Model.LastReservationDate.HasValue)
                    {
                        @Model.LastReservationDate.Value.ToString("MMM dd, yyyy")
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <hr class="my-4" />

    <h4 class="mb-3">Reservation History</h4>

    @if (!Model.ReservationHistory.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No reservations yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Guests</th>
                        <th>Table</th>
                        <th>Notes</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reservation in Model.ReservationHistory)
                    {
                        <tr class="@(reservation.IsPast ? "table-secondary" : "")">
                            <td>@reservation.Date.ToString("MMM dd, yyyy")</td>
                            <td>@reservation.Time.ToString(@"hh\:mm")</td>
                            <td><i class="bi bi-people-fill"></i> @reservation.NumberOfGuests</td>
                            <td>Table @reservation.TableNumber</td>
                            <td>@(reservation.Notes ?? "-")</td>
                            <td>
                                @if (reservation.IsPast)
                                {
                                    <span class="badge bg-secondary">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Upcoming</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-4 d-flex justify-content-between">
        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">
            <i class="bi bi-pencil"></i> Edit Status
        </a>
        <a class="btn btn-primary" asp-action="Index">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>