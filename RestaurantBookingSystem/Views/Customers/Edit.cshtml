@model RestaurantBookingSystem.ViewModels.Customer.CustomerEditViewModel

@{
    ViewData["Title"] = "Edit Customer Status";
}

<h2 class="text-center mb-4">
    <span class="title-container">Edit Customer Status</span>
</h2>

<div class="soft-box" style="max-width: 600px; margin: 0 auto;">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <!-- ✅ Hidden fields to preserve values -->
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="FullName" />
        <input type="hidden" asp-for="PhoneNumber" />
        <input type="hidden" asp-for="Email" />

        <div class="alert alert-info mb-4">
            <i class="bi bi-info-circle"></i>
            <strong>Note:</strong> Customer name, phone, and email cannot be edited here.
            They are managed through reservations.
        </div>

        <!-- ✅ Display-only fields (not submitted) -->
        <div class="mb-3">
            <label class="form-label"><strong>Full Name</strong></label>
            <input type="text" class="form-control" value="@Model.FullName" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label"><strong>Phone Number</strong></label>
            <input type="text" class="form-control" value="@Model.PhoneNumber" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label"><strong>Email</strong></label>
            <input type="text" class="form-control" value="@(Model.Email ?? "-")" readonly />
        </div>

        <hr class="my-4" />

        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option value="0">Regular</option>
                <option value="1">VIP</option>
                <option value="2">Blacklisted</option>
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
            <small class="text-muted">
                <i class="bi bi-info-circle"></i>
                VIP customers receive priority. Blacklisted customers cannot make reservations.
            </small>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="4"
                      placeholder="Add internal notes (preferences, restrictions, reasons for blacklist, etc.)"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-save"></i> Save Changes
            </button>
            <a class="btn btn-secondary px-4" asp-action="Details" asp-route-id="@Model.Id">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}