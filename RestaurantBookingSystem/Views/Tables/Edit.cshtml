@model RestaurantBookingSystem.ViewModels.Tables.TableFormViewModel

@{
    ViewData["Title"] = "Edit Table";
}

<h2 class="text-center mb-4">
    <span class="title-container">Edit Table</span>
</h2>

<div class="soft-box" style="max-width: 600px; margin: 0 auto;">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="TableNumber" class="form-label"></label>
            <input asp-for="TableNumber" class="form-control" type="number" min="@ValidationConstants.MinTableNumber" max="@ValidationConstants.MaxTableNumber" />
            <span asp-validation-for="TableNumber" class="text-danger"></span>
            <small class="text-muted">Table number must be unique (1-999)</small>
        </div>

        <div class="mb-3">
            <label asp-for="Seats" class="form-label"></label>
            <input asp-for="Seats" class="form-control" type="number" min="@ValidationConstants.MinSeats" max="@ValidationConstants.MaxSeats" />
            <span asp-validation-for="Seats" class="text-danger"></span>
            <small class="text-muted">Number of people this table can accommodate (1-20)</small>
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-save"></i> Save Changes
            </button>
            <a class="btn btn-secondary px-4" asp-action="Index">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}