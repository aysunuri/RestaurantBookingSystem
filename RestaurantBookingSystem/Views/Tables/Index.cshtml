@model IEnumerable<RestaurantBookingSystem.ViewModels.Tables.TableIndexViewModel>

@{
    ViewData["Title"] = "Tables";
}

<h2 class="text-center mb-4">
    <span class="title-container">Restaurant Tables</span>
</h2>

<div class="soft-box">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>All Tables</h3>
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Add New Table
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No tables found. Click "Add New Table" to create one.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Table Number</th>
                        <th>Capacity (Seats)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var table in Model)
                    {
                        <tr>
                            <td>
                                <strong>Table @table.TableNumber</strong>
                            </td>
                            <td>
                                <i class="bi bi-people-fill"></i> @table.Seats seats
                            </td>
                            <td>
                                <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@table.Id">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@table.Id">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@table.Id">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <p class="text-muted">
                <i class="bi bi-info-circle"></i> 
                Total: <strong>@Model.Count()</strong> tables | 
                Total capacity: <strong>@Model.Sum(t => t.Seats)</strong> seats
            </p>
        </div>
    }
</div>
