@model ReservationDetailsViewModel


<div class="d-flex justify-content-center">
	<div class="soft-box" style="max-width: 600px; width: 100%; margin: 0 auto;">

		<h2 class="text-center mb-4">Reservation Details</h2>
		<h4 class="mb-3">Reservation Information</h4>
		<p><strong>Date:</strong> @Model.Date</p>
		<p><strong>Time:</strong> @Model.Time</p>
		<p><strong>Guests:</strong> @Model.NumberOfGuests</p>
		<p><strong>Notes:</strong> @(Model.Notes ?? "No notes")</p>

		<hr />

		<h4 class="mb-3">Customer Information</h4>
		<p><strong>Name:</strong> @Model.CustomerName</p>
		<p><strong>Phone:</strong> @Model.CustomerPhone</p>
		<p><strong>Email:</strong> @(Model.CustomerEmail ?? "No email provided")</p>

		<hr />

		<h4 class="mb-3">Table Information</h4>
		<p><strong>Table Number:</strong> @Model.TableNumber</p>
		<p><strong>Seats:</strong> @Model.TableSeats</p>

		<div class="text-center mt-4">
			<a class="btn btn-primary px-4" asp-action="Index">Back to List</a>
		</div>

	</div>
</div>

