@model ReservationDetailsViewModel

@{
    ViewData["Title"] = "Reservation Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="soft-box">
        <!-- Header -->
        <div class="text-center mb-4">
            <h2 class="display-6 fw-bold">
                <i class="bi bi-receipt text-primary"></i>
                Reservation Details
            </h2>
        </div>
            <!-- Reservation Info -->
            <div class="mb-4 pb-3 border-bottom">
                <h5 class="text-primary mb-3">
                    <i class="bi bi-calendar-check"></i> Reservation Information
                </h5>

                <div class="row g-3">
                    <div class="col-md-6">
                        <p class="mb-2">
                            <i class="bi bi-calendar3 text-primary"></i>
                            <strong class="ms-2">Date:</strong>
                        </p>
                        <p class="ms-4 fs-5">@Model.Date</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-2">
                            <i class="bi bi-clock text-primary"></i>
                            <strong class="ms-2">Time:</strong>
                        </p>
                        <p class="ms-4 fs-5">@Model.Time</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-2">
                            <i class="bi bi-people text-primary"></i>
                            <strong class="ms-2">Number of Guests:</strong>
                        </p>
                        <p class="ms-4 fs-5">@Model.NumberOfGuests</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-2">
                            <i class="bi bi-table text-primary"></i>
                            <strong class="ms-2">Table:</strong>
                        </p>
                        <p class="ms-4 fs-5">
                            Table @Model.TableNumber
                            <span class="badge bg-secondary">@Model.TableSeats seats</span>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Customer Info -->
            <div class="mb-4 pb-3 border-bottom">
                <h5 class="text-primary mb-3">
                    <i class="bi bi-person-circle"></i> Customer Information
                </h5>

                <div class="row g-3">
                    <div class="col-md-6">
                        <p class="mb-2">
                            <i class="bi bi-person text-primary"></i>
                            <strong class="ms-2">Name:</strong>
                        </p>
                        <p class="ms-4">@Model.CustomerName</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-2">
                            <i class="bi bi-telephone text-primary"></i>
                            <strong class="ms-2">Phone:</strong>
                        </p>
                        <p class="ms-4">@Model.CustomerPhone</p>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.CustomerEmail))
                    {
                        <div class="col-12">
                            <p class="mb-2">
                                <i class="bi bi-envelope text-primary"></i>
                                <strong class="ms-2">Email:</strong>
                            </p>
                            <p class="ms-4">@Model.CustomerEmail</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Special Requests -->
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="mb-4">
                    <h5 class="text-primary mb-3">
                        <i class="bi bi-chat-left-text"></i> Special Requests
                    </h5>
                    <div class="alert alert-light">
                        <p class="mb-0">@Html.Encode(Model.Notes)</p>
                    </div>
                </div>
            }

            <!-- Action Buttons -->
            <div class="d-flex gap-3 justify-content-center mt-4 pt-3 border-top">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg px-4">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-lg px-4">
                    <i class="bi bi-trash"></i> Delete
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>

        
            </div>
        </div>
