@model PagedResult<ReservationIndexViewModel>
<h2 class="text-center mb-4">
	<span class="title-container">Reservations</span>
</h2>

<div class="text-center mb-3">
	<a class="btn btn-primary" asp-action="Create">+ Add New Reservation</a>

	@if (ViewBag.ShowAll == true)
	{
		<a class="btn btn-secondary" asp-action="Index" asp-route-page="1">
			<i class="bi bi-filter"></i> Show Recent Only
		</a>
	}
	else
	{
		<a class="btn btn-secondary" asp-action="Index" asp-route-showAll="true" asp-route-page="1">
			<i class="bi bi-clock-history"></i> Show All History
		</a>
	}
</div>

@if (ViewBag.ShowAll != true)
{
	<div class="alert alert-info text-center">
		Showing reservations from the last 7 days and upcoming
	</div>
}

<div class="soft-box">
	<table class="table table-striped mt-3">
		<thead>
			<tr>
				<th>Date</th>
				<th>Time</th>
				<th>Guests</th>
				<th>Customer</th>
				<th>Table</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var res in Model.Items)
			{
				<tr>
					<td>@res.Date</td>
					<td>@res.Time</td>
					<td>@res.NumberOfGuests</td>
					<td>@res.CustomerName</td>
					<td>@res.TableNumber</td>
					<td>
						<a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@res.Id">Details</a>
						<a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@res.Id">Edit</a>
						<a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@res.Id">Delete</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
	<div class="text-center mt-4">
		@if (Model.TotalPages > 1)
		{
			<!-- Previous -->
			@if (Model.CurrentPage > 1)
			{
				<a class="btn btn-outline-primary"
				   asp-action="Index"
				   asp-route-page="@(Model.CurrentPage - 1)"
				   asp-route-showAll="@ViewBag.ShowAll">
					Previous
				</a>
			}
			else
			{
				<button class="btn btn-outline-secondary" disabled>Previous</button>
			}

			<!-- Page numbers -->
				int startPage = Math.Max(1, Model.CurrentPage - 2);
				int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);


			@for (int i = startPage; i <= endPage; i++)
			{
				<a class="btn @(i == Model.CurrentPage ? "btn-primary" : "btn-outline-primary")"
				   asp-action="Index"
				   asp-route-page="@i"
				   asp-route-showAll="@ViewBag.ShowAll">
					@i
				</a>
			}

			<!-- Next -->
			@if (Model.CurrentPage < Model.TotalPages)
			{
				<a class="btn btn-outline-primary"
				   asp-action="Index"
				   asp-route-page="@(Model.CurrentPage + 1)"
				   asp-route-showAll="@ViewBag.ShowAll">
					Next
				</a>
			}
			else
			{
				<button class="btn btn-outline-secondary" disabled>Next</button>
			}
		}
		else
		{
			<!-- ✅ Show disabled pagination when only 1 page -->
			<button class="btn btn-outline-secondary" disabled>Previous</button>
			<button class="btn btn-primary">1</button>
			<button class="btn btn-outline-secondary" disabled>Next</button>
		}

		<!-- Optional: Show pagination info -->
		@if (Model.Items.Any())
		{
			<div class="text-muted mt-2">
				<small>Page @Model.CurrentPage of @Model.TotalPages</small>
			</div>
		}
	</div>
	@if (!Model.Items.Any())
	{
		<p class="text-center text-muted mt-4">No reservations found.</p>
	}
</div>