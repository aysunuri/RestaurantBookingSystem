@model IEnumerable<ReservationIndexViewModel>


<h2 class="text-center mb-4">
    <span class="title-container">Reservations</span>
</h2>

<div class="text-center mb-3">
    <a class="btn btn-primary" href="/Reservations/Create">+ Add New Reservation</a>
</div>

<div class="soft-box">
<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Date</th>
            <th>Time</th>
            <th>Guests</th>
            <th>Customer</th>
            <th>Table</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (ReservationIndexViewModel res in Model)
        {
            <tr>
                <td>@res.Date</td>
                <td>@res.Time</td>
                <td>@res.NumberOfGuests</td>
                <td>@res.CustomerName</td>
                <td>@res.TableNumber</td>
                <td>
                    <a class="btn btn-sm btn-info" href="/Reservations/Details/@res.Id">Details</a>
                    <a class="btn btn-sm btn-warning" href="/Reservations/Edit/@res.Id">Edit</a>
                    <a class="btn btn-sm btn-danger" href="/Reservations/Delete/@res.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>


